{
  "schemaVersion": 1,
  "id": "menukit-containers",
  "version": "${version}",
  "name": "MenuKit: Containers",
  "icon": "icon.png",
  "description": "Adds slots to MenuKit: slots that persist and sync, custom container menus, and per-slot state the server checks. Needed on both the client and the server.",
  "authors": ["trevorschoeny"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.trevlar.menukit.containers.MenuKitContainers"],
    "client": ["com.trevlar.menukit.containers.MenuKitContainersClient"]
  },
  "mixins": ["menukit-containers.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "menukit": "${version}"
  },
  "breaks": {
    "inventoryplus": "<1.6.0",
    "inventorymax": "<1.0.3",
    "hivesight": "<1.0.2",
    "offshore": "<1.0.2",
    "keybindery": "<1.0.4"
  }
}
